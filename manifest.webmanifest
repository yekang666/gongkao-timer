      "url": "./?mode=section&preset=ziliao",
      "icons": [{ "src": "assets/app-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "自由测速",
      "short_name": "自由测速",
      "description": "打开即用的正计时逐题测速",
